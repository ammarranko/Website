{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#6.8",
	"phpVersion": "8.2",
	"testsEnvironment": false,
	"themes": [ "./themes/badr" ],
	"plugins": [ "./plugins/badr-site-core" ],
	"mappings": {
		"wp-content/badr-project": "."
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true,
		"WP_DEFAULT_THEME": "badr"
	}
}
