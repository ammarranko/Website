			"radius": {
				"sm": "4px",
				"md": "8px",
				"lg": "16px",
				"pill": "999px"
			},
			"motion": {
				"fast": "150ms",
				"base": "250ms",
				"slow": "350ms",
				"ease": "cubic-bezier(0.22, 0.61, 0.36, 1)"
			},
			"target": {
				"min": "44px"
			},
			"wash": {
				"leaf": "rgba(66, 156, 44, 0.10)",
				"flame": "rgba(227, 51, 19, 0.09)",
				"amber": "rgba(250, 134, 3, 0.11)",
				"azure": "rgba(1, 57, 84, 0.09)"
