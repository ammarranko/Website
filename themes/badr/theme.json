				{
					"slug": "raised",
					"name": "Légère",
					"shadow": "0 1px 2px rgba(11, 42, 61, 0.06), 0 2px 8px rgba(11, 42, 61, 0.06)"
				},
				{
					"slug": "lifted",
					"name": "Marquée",
					"shadow": "0 2px 4px rgba(11, 42, 61, 0.08), 0 12px 28px rgba(11, 42, 61, 0.10)"
